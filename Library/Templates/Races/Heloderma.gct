									"id": "mO-yIRJvhAE3tg5gX",
									"name": "No Vitals",
									"reference": "B61",
									"local_notes": "Attacks to the Vitals or Groin are treated as attacks to the Torso",
									"cost_adj": "5",
									"disabled": true
								},
